# Required
GOOGLE_MAPS_API_KEY=your_key_here

# Host/server URLs
STREETVIEW_HOST_URL=http://localhost:3000
GEOGUESSR_SERVER_URL=http://localhost:8000
SERVER_PORT=8000
STREETVIEW_HOST_PORT=3000

# Image output
IMAGE_OUTPUT_DIR=images

# Optional: host pool size
POOL_SIZE=20

# Session management (server)
SESSION_IDLE_TIMEOUT=300
SESSION_MAX_AGE=1800
SESSION_SWEEP_INTERVAL=60
USE_WAITRESS=true

# Host client retry/timeout
HOST_CLIENT_TIMEOUT=30
HOST_CLIENT_MAX_ATTEMPTS=3

# Image fetch tuning
IMAGE_FETCH_MAX_ATTEMPTS=6
IMAGE_FETCH_BACKOFF_SECS=1.0
IMAGE_FETCH_JITTER_SECS=5
IMAGE_FETCH_TIMEOUT_SECS=10
IMAGE_FETCH_MAX_CONCURRENT=8
# Backward-compatible name
IMAGE_FETCH_CONCURRENCY=8

# Optional URL signing
GOOGLE_MAPS_URL_SIGNING_SECRET=
