# Existing panorama metadata database and pre-captured JPEGs.
MAPCRUNCH_DB_PATH=/absolute/path/to/mapcrunch.db
MAPCRUNCH_GCS_BUCKET=geoguesr
MAPCRUNCH_GCS_PREFIX=mapcrunch_images/

# Use Application Default Credentials authorized to read the bucket.
GOOGLE_CLOUD_PROJECT=your-project-id

# Persistent JPEG cache; size 0 disables caching.
MAPCRUNCH_CACHE_DIR=/tmp/mapcrunch_cache
MAPCRUNCH_CACHE_SIZE_GB=5

# HTTP server; matches street_view.py's default URL.
HOST=127.0.0.1
PORT=18000
SERVER_THREADS=8
# Accepted HTTP connections, including idle keep-alive connections; separate from worker threads.
SERVER_CONNECTION_LIMIT=100
# Idle sessions are reclaimed on the next /connect; timeout is in seconds (12 hours).
SESSION_IDLE_TIMEOUT=43200

# Optional image ablation: off, top, or bottom.
GEOGUESSR_CROP=off
